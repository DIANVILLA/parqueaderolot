# Desarrollo local en el computador:
REACT_APP_API_URL=http://localhost:8090/api

# Para probar desde celular con GitHub/VS Code Tunnel:
# 1. Reenvia el puerto 8090 del backend y ponlo Public.
# 2. Copia la URL publica HTTPS del puerto 8090.
# 3. Crea un archivo .env.local con esta linea, reemplazando la URL:
# REACT_APP_API_URL=https://URL-PUBLICA-DEL-PUERTO-8090/api
